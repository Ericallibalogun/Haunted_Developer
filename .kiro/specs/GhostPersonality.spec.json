  "haunt_probability": {
    "day": 0.1,
    "dusk": 0.3,
    "night": 0.5,
    "witching": 0.8,
    "full_moon_multiplier": 1.5
  },
  "memory_system": {
    "max_memories": 10,
    "memory_format": {
      "message": "string",
      "timestamp": "number",
      "state": "string"
    },
    "recall": "Use memories for contextual responses"
  },
  "night_mode": {
    "witching_hours": "12am-3am",
    "power_multiplier": 2.0,
    "response_formatting": "✨ UPPERCASE ✨",
    "whisper_frequency": "Every 2-3 pulses"
  }
